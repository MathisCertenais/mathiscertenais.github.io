# Canonical production origin used for absolute Open Graph and canonical URLs.
VITE_SITE_URL=

# Delivers the Contact form. Create a free access key at https://web3forms.com
# and paste it here (and into the repository secrets for the deploy workflow).
# The key is public by design: it travels in the built bundle and only ever
# routes a message to the inbox it was created for.
VITE_WEB3FORMS_KEY=

# Alternative transport: an endpoint you own, which receives the form as
# multipart form data. Used only when no access key is set above.
VITE_CONTACT_ENDPOINT=
